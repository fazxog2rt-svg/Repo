FROM node:20-alpine

RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    git \
    libc6-compat

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY tsconfig.json ./
COPY server ./server
COPY prisma ./prisma
COPY lib ./lib

ENV NODE_ENV=production
ENV WA_SESSION_PATH=/app/wa-session

RUN mkdir -p /app/wa-session

CMD ["npx", "ts-node", "--project", "tsconfig.json", "server/whatsapp/bot.ts"]
