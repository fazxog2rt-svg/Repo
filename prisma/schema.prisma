generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

enum PlanType {
  FREE
  BASIC
  PRO
  PREMIUM
  ENTERPRISE
}

enum InvoiceStatus {
  PENDING
  PAID
  EXPIRED
  REJECTED
  CANCELLED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum FileType {
  PDF
  DOCX
  PPTX
  XLSX
  TXT
  CSV
  ZIP
  PNG
  JPG
  MP3
  MP4
  OTHER
}

enum NotificationType {
  SYSTEM
  PAYMENT
  SUBSCRIPTION
  CHAT
  ADMIN
}

enum AdminLogAction {
  USER_CREATED
  USER_UPDATED
  USER_SUSPENDED
  USER_BANNED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_CANCELLED
  PLAN_CREATED
  PLAN_UPDATED
  PLAN_DELETED
  SETTINGS_UPDATED
}

// ============================================================
// AUTHENTICATION
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  isBanned      Boolean   @default(false)
  isSuspended   Boolean   @default(false)
  phone         String?
  bio           String?
  language      String    @default("en")
  timezone      String    @default("Asia/Jakarta")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  chats            Chat[]
  files            File[]
  agents           Agent[]
  prompts          Prompt[]
  subscriptions    Subscription[]
  invoices         Invoice[]
  apiKeys          ApiKey[]
  notifications    Notification[]
  usage            Usage[]
  documents        Document[]
  workspaces       Workspace[]
  adminLogs        AdminLog[]     @relation("AdminLogs")
  targetAdminLogs  AdminLog[]     @relation("TargetAdminLogs")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// CHAT
// ============================================================

model Chat {
  id          String    @id @default(cuid())
  title       String    @default("New Chat")
  userId      String
  folderId    String?
  agentId     String?
  modelId     String    @default("openai/gpt-4o")
  isPinned    Boolean   @default(false)
  isArchived  Boolean   @default(false)
  shareToken  String?   @unique
  isShared    Boolean   @default(false)
  systemPrompt String?  @db.Text
  temperature Float     @default(0.7)
  maxTokens   Int       @default(4096)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder    ChatFolder? @relation(fields: [folderId], references: [id])
  agent     Agent?     @relation(fields: [agentId], references: [id])
  messages  Message[]

  @@index([userId])
  @@index([folderId])
  @@map("chats")
}

model ChatFolder {
  id        String   @id @default(cuid())
  name      String
  userId    String
  color     String?
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chats Chat[]

  @@map("chat_folders")
}

model Message {
  id          String      @id @default(cuid())
  chatId      String
  role        MessageRole
  content     String      @db.Text
  modelId     String?
  tokens      Int?
  isEdited    Boolean     @default(false)
  editedAt    DateTime?
  metadata    Json?
  createdAt   DateTime    @default(now())

  chat  Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  files MessageFile[]

  @@index([chatId])
  @@map("messages")
}

model MessageFile {
  id        String @id @default(cuid())
  messageId String
  fileId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id])

  @@map("message_files")
}

// ============================================================
// FILES & DOCUMENTS
// ============================================================

model File {
  id           String   @id @default(cuid())
  userId       String
  name         String
  originalName String
  url          String
  size         Int
  mimeType     String
  fileType     FileType @default(OTHER)
  extractedText String? @db.Text
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageFiles MessageFile[]

  @@index([userId])
  @@map("files")
}

model Document {
  id          String   @id @default(cuid())
  userId      String
  title       String
  content     String   @db.Text
  type        String   @default("markdown")
  isPublic    Boolean  @default(false)
  shareToken  String?  @unique
  folderId    String?
  tags        String[]
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("documents")
}

model Workspace {
  id          String   @id @default(cuid())
  userId      String
  title       String
  content     Json
  type        String   @default("document")
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("workspaces")
}

// ============================================================
// AI AGENTS & PROMPTS
// ============================================================

model Agent {
  id               String  @id @default(cuid())
  userId           String
  name             String
  description      String? @db.Text
  avatar           String?
  systemPrompt     String  @db.Text
  modelId          String  @default("openai/gpt-4o")
  temperature      Float   @default(0.7)
  maxTokens        Int     @default(4096)
  topP             Float   @default(1.0)
  presencePenalty  Float   @default(0.0)
  frequencyPenalty Float   @default(0.0)
  isPublic         Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats Chat[]

  @@index([userId])
  @@map("agents")
}

model Prompt {
  id          String   @id @default(cuid())
  userId      String?
  title       String
  content     String   @db.Text
  category    String
  description String?  @db.Text
  tags        String[]
  isPublic    Boolean  @default(false)
  isFavorited Boolean  @default(false)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([category])
  @@map("prompts")
}

// ============================================================
// SUBSCRIPTION & BILLING
// ============================================================

model Plan {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  type              PlanType
  description       String?  @db.Text
  price             Decimal  @db.Decimal(10, 2)
  currency          String   @default("IDR")
  period            String   @default("monthly")
  monthlyTokens     Int
  features          Json
  availableModels   String[]
  maxChats          Int      @default(-1)
  maxAgents         Int      @default(5)
  maxFileSize       Int      @default(10)
  maxStorageGB      Float    @default(1.0)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]

  @@map("plans")
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  planId            String
  status            SubscriptionStatus @default(PENDING)
  startDate         DateTime?
  endDate           DateTime?
  tokensUsed        Int                @default(0)
  tokensLimit       Int
  autoRenew         Boolean            @default(false)
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@map("subscriptions")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  userId        String
  planId        String
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("IDR")
  status        InvoiceStatus @default(PENDING)
  bankName      String?
  bankAccount   String?
  bankOwner     String?
  expiredAt     DateTime
  paidAt        DateTime?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  rejectionNote String?       @db.Text
  whatsappPhone String?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id])
  paymentProof PaymentProof?

  @@index([userId])
  @@index([status])
  @@map("invoices")
}

model PaymentProof {
  id           String   @id @default(cuid())
  invoiceId    String   @unique
  senderName   String
  senderBank   String
  amount       Decimal  @db.Decimal(10, 2)
  imageUrl     String?
  whatsappMsgId String?
  submittedAt  DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payment_proofs")
}

// ============================================================
// API KEYS
// ============================================================

model ApiKey {
  id           String   @id @default(cuid())
  userId       String
  name         String
  encryptedKey String   @db.Text
  provider     String   @default("openrouter")
  isActive     Boolean  @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("api_keys")
}

// ============================================================
// USAGE TRACKING
// ============================================================

model Usage {
  id          String   @id @default(cuid())
  userId      String
  modelId     String
  feature     String
  tokensUsed  Int      @default(0)
  cost        Decimal? @db.Decimal(10, 6)
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("usage")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// ============================================================
// ADMIN
// ============================================================

model AdminLog {
  id        String         @id @default(cuid())
  adminId   String
  targetId  String?
  action    AdminLogAction
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime       @default(now())

  admin  User  @relation("AdminLogs", fields: [adminId], references: [id])
  target User? @relation("TargetAdminLogs", fields: [targetId], references: [id])

  @@index([adminId])
  @@map("admin_logs")
}

model WhatsAppSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  data      Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whatsapp_sessions")
}

model Analytics {
  id        String   @id @default(cuid())
  event     String
  userId    String?
  data      Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
  @@map("analytics")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
