# =============================================================
# NEXUS AI - Environment Variables
# =============================================================
# Copy this file to .env and fill in your values

# =============================================================
# DATABASE
# =============================================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/nexusai?schema=public"

# =============================================================
# NEXTAUTH / AUTH.JS
# =============================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-here"

# =============================================================
# OAUTH PROVIDERS
# =============================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# =============================================================
# ENCRYPTION (for API keys)
# AES-256 key - must be exactly 32 chars
# =============================================================
ENCRYPTION_KEY="your-32-char-encryption-key-here!!"
ENCRYPTION_IV="your-16-char-iv!!"

# =============================================================
# REDIS
# =============================================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# =============================================================
# EMAIL (SMTP)
# =============================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NexusAI <noreply@nexusai.com>"

# =============================================================
# OPENROUTER
# System-level API key (for model listing only)
# Users provide their own API keys via the UI
# =============================================================
OPENROUTER_SYSTEM_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# =============================================================
# FILE UPLOAD
# =============================================================
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="50"
# For production, use S3/R2:
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_ENDPOINT=""

# =============================================================
# WHATSAPP BOT (Baileys)
# =============================================================
WA_BOT_PHONE=""
WA_SESSION_PATH="./wa-session"
WA_ADMIN_PHONE=""
WA_ADMIN_PHONE2=""

# =============================================================
# PAYMENT (Bank Transfer)
# =============================================================
BANK_NAME="Bank Central Asia (BCA)"
BANK_ACCOUNT="1234567890"
BANK_OWNER="PT Nexus AI Indonesia"
INVOICE_EXPIRE_MINUTES="30"

# =============================================================
# SOCKET.IO
# =============================================================
SOCKET_PORT="3001"

# =============================================================
# APP CONFIG
# =============================================================
APP_NAME="NexusAI"
APP_URL="http://localhost:3000"
APP_DESCRIPTION="Premium AI SaaS Platform"
NODE_ENV="development"

# =============================================================
# RATE LIMITING
# =============================================================
RATE_LIMIT_CHAT_PER_MINUTE="30"
RATE_LIMIT_API_PER_MINUTE="60"
RATE_LIMIT_AUTH_PER_HOUR="10"

# =============================================================
# JWT
# =============================================================
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"
